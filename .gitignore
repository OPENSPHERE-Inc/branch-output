# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/src
!.clang-format
!.cmake-format.json
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber

# Except additional project files
!screenshot1.jpg
!screenshot2.jpg
!build.ps1
# Submodules under lib/ use an explicit allowlist: `/lib/*` re-excludes everything under
# lib/, so each new submodule must be re-included with its own `!/lib/<name>` line below.
# Forgetting that line silently drops the submodule from `git add .`.
!/lib
/lib/*
!/lib/obs-websocket
!.gitmodules
!README_ja.md
!API.md
!API_ja.md

# Except for AI agent instructions
!AGENTS.md
!CLAUDE.md
!/.claude
